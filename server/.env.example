# ScamShield — server/ environment variables
#
# This is the backend the Flutter app actually talks to (port 8000).
# Copy to server/.env and fill in values. Never commit server/.env.
#
# SECURITY NOTE: every key below is a SERVER-side secret. Do not embed any of
# them in the Flutter client — anything shipped in an APK can be extracted by
# decompiling it. The client calls the /osint/* proxy endpoints instead.

# ─────────────────────────────────────────────────────────────────────────────
# AI — optional
# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini API key — https://aistudio.google.com/
# If unset, /analyze automatically falls back to the local heuristic engine
# and returns aiPowered=false. The service remains fully functional.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# THREAT INTELLIGENCE — all optional
# ─────────────────────────────────────────────────────────────────────────────
# When a key is absent, the corresponding lookup returns an explicit
# "not configured — result unverified" note. It never fabricates a verdict.

# https://www.virustotal.com/  (used by POST /scan and GET /osint/hash/{hash})
# When set, the APK report's "VirusTotal" card shows a live multi-engine
# verdict instead of "Cloud Check Not Run".
VIRUSTOTAL_API_KEY=

# https://developers.google.com/safe-browsing  (used by POST /osint/urls and POST /scan)
# When set, the APK report's "Google Safe Browsing" card screens the URLs
# extracted from the APK instead of reporting them as unchecked.
GOOGLE_SAFE_BROWSING_API_KEY=

# https://www.abuseipdb.com/  (used by GET /osint/ip/{ip})
ABUSEIPDB_API_KEY=

# https://xposedornot.com/api_doc  (used by GET /api/v1/breach and /breach)
# Public breach-analytics endpoint. Currently keyless; set only if you have one.
XPOSEDORNOT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Rate limiting on /analyze, /scan and /osint/*. Set to "false" to disable
# (development only — leave enabled in production).
RATE_LIMIT_ENABLED=true

# Token required by the admin-only endpoints (Authorization: Bearer <token>
# or X-Admin-Key). CHANGE THIS from the default before any real deployment.
ADMIN_API_KEY=change_me_before_deploy

# Comma-separated allowed CORS origins. "*" is acceptable for local
# development only — set explicit origins in production.
ALLOWED_ORIGINS=*
