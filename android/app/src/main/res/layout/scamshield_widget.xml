<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget layout.
     Deliberately one action and one line of status. A widget competing for
     space with the user's other tiles earns none of it by being dense; the
     whole value here is that checking a suspicious message is one tap from
     the home screen instead of four. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_status_default"/>

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#0F172A"
        android:textStyle="bold"
        android:textSize="14sp"
        android:text="@string/widget_action_label"/>
</LinearLayout>
