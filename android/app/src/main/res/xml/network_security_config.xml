<?xml version="1.0" encoding="utf-8"?>
<!-- Release / production network security policy.
     Cleartext HTTP is forbidden everywhere. All API traffic must be HTTPS.
     Debug builds override this file with a permissive variant so local
     development against http://10.0.2.2:8000 keeps working. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
