<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface. Matches AppColors.surface from the Flutter theme so the
     widget reads as part of the same app rather than a stray tile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1E293B"/>
    <corners android:radius="20dp"/>
    <stroke android:width="1dp" android:color="#334155"/>
</shape>
