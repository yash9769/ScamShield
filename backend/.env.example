# ScamShield Backend — Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit the .env file to version control.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Admin API key — used to protect /dashboard and /api/audit-logs.
# REQUIRED: the server refuses to start without it. Use a long random string,
# e.g. `openssl rand -hex 32`. There is intentionally no default value.
ADMIN_API_KEY=

# Interactive API docs (/docs, /redoc, /openapi.json). These are DISABLED by
# default in production to avoid exposing the full route surface. Set to true
# for local development (DEBUG=true also enables them).
ENABLE_DOCS=false

# Google Gemini API key — REQUIRED for AI analysis. Get one at https://aistudio.google.com/
# If this is empty, the backend will run in heuristic-only mode with limited AI capabilities
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL password for the Docker stack.
# REQUIRED by docker-compose (no default — the stack refuses to start without
# it). Use a long random string, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# MobSF API key.
# REQUIRED by docker-compose (no default). Set the same value on the MobSF
# service. e.g. `openssl rand -hex 32`.
MOBSF_API_KEY=

# Comma-separated trusted reverse proxies allowed to set X-Forwarded-For.
# Leave empty when the API is exposed directly. When set (e.g.
# TRUSTED_PROXIES=10.0.0.1,127.0.0.1) the rate limiter trusts forwarded
# headers ONLY from these peers — never from arbitrary clients.
TRUSTED_PROXIES=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — OSINT
# ─────────────────────────────────────────────────────────────────────────────

# VirusTotal API key — free tier available at https://www.virustotal.com/
# Leave empty to disable URL scanning (analysis still works without it).
VIRUSTOTAL_API_KEY=

# Google Safe Browsing API key (optional)
# Leave empty to disable URL lookups via /osint/urls.
GOOGLE_SAFE_BROWSING_API_KEY=

# AbuseIPDB API key (optional)
# Leave empty to disable IP lookups via /osint/ip/{ip}.
ABUSEIPDB_API_KEY=

# XposedOrNot API Key — Optional but recommended for higher rate limits.
# Free tier works without an API key, but you may hit rate limits with heavy usage.
# Get an API key at https://xposedornot.com/api
XPOSEDORNOT_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────

# Redis URL for rate limiting and OSINT caching.
# Use "memory://" to fall back to in-memory (single process only).
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Set to true to enable auto-reload (development only)
DEBUG=false

# Explicit, comma-separated list of allowed CORS origins.
# The mobile app does not use CORS, so leave empty unless you run a web client.
# NEVER use "*" in production.
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# CLIENT AUTH (ON by default)
# ─────────────────────────────────────────────────────────────────────────────

# When true, ALL sensitive endpoints (/analyze, /analyze-voice, /analyze-image,
# /analyze-batch, /scan*, /history, /breach, /osint/*) require an
# X-Device-Token or X-API-Key. The Flutter app sends an anonymous per-install
# device token automatically, so a legitimate client is never blocked.
# Disable ONLY for self-hosted / trusted-network deployments.
API_AUTH_ENABLED=true

# Comma-separated server-to-server API keys (used with X-API-Key).
API_KEYS=

# ─────────────────────────────────────────────────────────────────────────────
# AI / GEMINI
# ─────────────────────────────────────────────────────────────────────────────

# Gemini models to try in order (comma-separated)
# GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

# Gemini request timeout in seconds
# GEMINI_TIMEOUT=15.0

# Number of retry attempts per Gemini model
# GEMINI_MAX_RETRIES=2

# Score aggregation weights (must sum to 1.0)
# GEMINI_WEIGHT=0.55
# HEURISTIC_WEIGHT=0.30
# OSINT_WEIGHT=0.15

# LLM verdict cache: time-to-live in seconds and max cached verdicts.
# Repeated messages (same link/SMS template) skip the paid LLM call.
# LLM_CACHE_TTL=3600
# LLM_CACHE_SIZE=512

# ─────────────────────────────────────────────────────────────────────────────
# VOICE / WHISPER
# ─────────────────────────────────────────────────────────────────────────────

# Whisper model size: tiny | base | small | medium | large
# larger = more accurate but slower and more RAM
WHISPER_MODEL=base

# Maximum audio file size in MB
# MAX_AUDIO_SIZE_MB=25

# ─────────────────────────────────────────────────────────────────────────────
# OCR / EASYOCR
# ─────────────────────────────────────────────────────────────────────────────

# Enable GPU acceleration for EasyOCR (requires CUDA)
# OCR_GPU=false

# Maximum image file size in MB
# MAX_IMAGE_SIZE_MB=10

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────

# RATE_LIMIT_ANALYZE=60/minute
# RATE_LIMIT_VOICE=10/minute
# RATE_LIMIT_IMAGE=10/minute
# RATE_LIMIT_BATCH=20/minute

# ─────────────────────────────────────────────────────────────────────────────
# BATCH
# ─────────────────────────────────────────────────────────────────────────────

# Max items per batch request
# BATCH_MAX_ITEMS=20

# Number of concurrent AI calls during batch processing
# BATCH_CONCURRENCY=5

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE / CRASH REPORTING
# ─────────────────────────────────────────────────────────────────────────────

# APK upload + report storage directories (Docker defaults to /app/...).
# UPLOAD_DIR=uploads
# REPORTS_DIR=reports
# YARA_RULES_DIR=yara_rules

# Sentry DSN for server crash reporting (optional — leave empty to disable).
# SENTRY_DSN=