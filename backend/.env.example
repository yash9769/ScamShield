# ScamShield Backend — Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit the .env file to version control.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key — get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — OSINT
# ─────────────────────────────────────────────────────────────────────────────

# VirusTotal API key — free tier available at https://www.virustotal.com/
# Leave empty to disable URL scanning (analysis still works without it).
VIRUSTOTAL_API_KEY=

# XposedOrNot API Key (Optional)
# Leave empty to use the free public endpoints without a key.
XPOSEDORNOT_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────

# Redis URL for rate limiting and OSINT caching.
# Use "memory://" to fall back to in-memory (single process only).
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Set to true to enable auto-reload (development only)
DEBUG=false

# Comma-separated list of allowed CORS origins.
# Use * for development. Restrict in production.
ALLOWED_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────────────
# AI / GEMINI
# ─────────────────────────────────────────────────────────────────────────────

# Gemini models to try in order (comma-separated)
# GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

# Gemini request timeout in seconds
# GEMINI_TIMEOUT=15.0

# Number of retry attempts per Gemini model
# GEMINI_MAX_RETRIES=2

# Score aggregation weights (must sum to 1.0)
# GEMINI_WEIGHT=0.55
# HEURISTIC_WEIGHT=0.30
# OSINT_WEIGHT=0.15

# ─────────────────────────────────────────────────────────────────────────────
# VOICE / WHISPER
# ─────────────────────────────────────────────────────────────────────────────

# Whisper model size: tiny | base | small | medium | large
# larger = more accurate but slower and more RAM
WHISPER_MODEL=base

# Maximum audio file size in MB
# MAX_AUDIO_SIZE_MB=25

# ─────────────────────────────────────────────────────────────────────────────
# OCR / EASYOCR
# ─────────────────────────────────────────────────────────────────────────────

# Enable GPU acceleration for EasyOCR (requires CUDA)
# OCR_GPU=false

# Maximum image file size in MB
# MAX_IMAGE_SIZE_MB=10

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────

# RATE_LIMIT_ANALYZE=60/minute
# RATE_LIMIT_VOICE=10/minute
# RATE_LIMIT_IMAGE=10/minute
# RATE_LIMIT_BATCH=20/minute

# ─────────────────────────────────────────────────────────────────────────────
# BATCH
# ─────────────────────────────────────────────────────────────────────────────

# Max items per batch request
# BATCH_MAX_ITEMS=20

# Number of concurrent AI calls during batch processing
# BATCH_CONCURRENCY=5
